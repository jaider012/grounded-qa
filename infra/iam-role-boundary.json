{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "InvokeGroundedQaFoundationModels",
      "Effect": "Allow",
      "Action": "bedrock:InvokeModel",
      "Resource": [
        "arn:aws:bedrock:us-east-1::foundation-model/deepseek.v3.2",
        "arn:aws:bedrock:us-east-1::foundation-model/amazon.nova-lite-v1:0",
        "arn:aws:bedrock:us-east-1::foundation-model/amazon.titan-embed-text-v2:0"
      ]
    },
    {
      "Sid": "EcrPullGroundedQa",
      "Effect": "Allow",
      "Action": [
        "ecr:GetDownloadUrlForLayer",
        "ecr:BatchGetImage",
        "ecr:DescribeImages",
        "ecr:BatchCheckLayerAvailability"
      ],
      "Resource": "arn:aws:ecr:us-east-1:717279723515:repository/grounded-qa"
    },
    {
      "Sid": "EcrAuthToken",
      "Effect": "Allow",
      "Action": "ecr:GetAuthorizationToken",
      "Resource": "*"
    },
    {
      "Sid": "ReadGroundedQaSsmParameters",
      "Effect": "Allow",
      "Action": "ssm:GetParameters",
      "Resource": "arn:aws:ssm:us-east-1:717279723515:parameter/grounded-qa/*"
    },
    {
      "Sid": "BudgetKillSwitchAttachDetach",
      "Effect": "Allow",
      "Action": [
        "iam:AttachRolePolicy",
        "iam:DetachRolePolicy"
      ],
      "Resource": "arn:aws:iam::717279723515:role/grounded-qa-apprunner-instance",
      "Condition": {
        "ArnEquals": {
          "iam:PolicyARN": "arn:aws:iam::717279723515:policy/grounded-qa-bedrock-kill-switch"
        }
      }
    }
  ]
}
