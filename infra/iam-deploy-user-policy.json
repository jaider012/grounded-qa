{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "BedrockInvokeForLocalRunsAndEval",
      "Effect": "Allow",
      "Action": "bedrock:InvokeModel",
      "Resource": [
        "arn:aws:bedrock:us-east-1::foundation-model/deepseek.v3.2",
        "arn:aws:bedrock:us-east-1::foundation-model/amazon.nova-lite-v1:0",
        "arn:aws:bedrock:us-east-1::foundation-model/amazon.titan-embed-text-v2:0"
      ]
    },
    {
      "Sid": "BedrockReadOnlyDiscovery",
      "Effect": "Allow",
      "Action": [
        "bedrock:ListFoundationModels",
        "bedrock:GetFoundationModel",
        "bedrock:GetFoundationModelAvailability",
        "bedrock:ListInferenceProfiles"
      ],
      "Resource": "*"
    },
    {
      "Sid": "EcrRepository",
      "Effect": "Allow",
      "Action": "ecr:*",
      "Resource": "arn:aws:ecr:us-east-1:717279723515:repository/grounded-qa"
    },
    {
      "Sid": "EcrLogin",
      "Effect": "Allow",
      "Action": "ecr:GetAuthorizationToken",
      "Resource": "*"
    },
    {
      "Sid": "AppRunnerInThisAccount",
      "Effect": "Allow",
      "Action": "apprunner:*",
      "Resource": "arn:aws:apprunner:us-east-1:717279723515:*"
    },
    {
      "Sid": "AppRunnerListCalls",
      "Effect": "Allow",
      "Action": "apprunner:List*",
      "Resource": "*"
    },
    {
      "Sid": "ManageOnlyGroundedQaRoles",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole",
        "iam:DeleteRole",
        "iam:GetRole",
        "iam:TagRole",
        "iam:UntagRole",
        "iam:UpdateAssumeRolePolicy",
        "iam:PutRolePolicy",
        "iam:GetRolePolicy",
        "iam:DeleteRolePolicy",
        "iam:ListRolePolicies",
        "iam:AttachRolePolicy",
        "iam:DetachRolePolicy",
        "iam:ListAttachedRolePolicies",
        "iam:ListInstanceProfilesForRole"
      ],
      "Resource": "arn:aws:iam::717279723515:role/grounded-qa-*"
    },
    {
      "Sid": "PassGroundedQaRolesToAppRunner",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::717279723515:role/grounded-qa-*",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": [
            "apprunner.amazonaws.com",
            "build.apprunner.amazonaws.com",
            "tasks.apprunner.amazonaws.com"
          ]
        }
      }
    },
    {
      "Sid": "AppRunnerServiceLinkedRole",
      "Effect": "Allow",
      "Action": "iam:CreateServiceLinkedRole",
      "Resource": "arn:aws:iam::717279723515:role/aws-service-role/apprunner.amazonaws.com/AWSServiceRoleForAppRunner",
      "Condition": {
        "StringLike": { "iam:AWSServiceName": "apprunner.amazonaws.com" }
      }
    },
    {
      "Sid": "ReadAppRunnerLogs",
      "Effect": "Allow",
      "Action": [
        "logs:DescribeLogGroups",
        "logs:DescribeLogStreams",
        "logs:GetLogEvents",
        "logs:FilterLogEvents"
      ],
      "Resource": "arn:aws:logs:us-east-1:717279723515:log-group:/aws/apprunner/grounded-qa/*"
    },
    {
      "Sid": "MonthlyBudget",
      "Effect": "Allow",
      "Action": [
        "budgets:ViewBudget",
        "budgets:ModifyBudget"
      ],
      "Resource": "arn:aws:budgets::717279723515:budget/grounded-qa-monthly"
    }
  ]
}
