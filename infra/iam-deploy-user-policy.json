{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "BedrockInvokeForLocalRunsAndEval",
      "Effect": "Allow",
      "Action": "bedrock:InvokeModel",
      "Resource": [
        "arn:aws:bedrock:us-east-1::foundation-model/deepseek.v3.2",
        "arn:aws:bedrock:us-east-1::foundation-model/amazon.nova-lite-v1:0",
        "arn:aws:bedrock:us-east-1::foundation-model/amazon.titan-embed-text-v2:0"
      ]
    },
    {
      "Sid": "BedrockReadOnlyDiscovery",
      "Effect": "Allow",
      "Action": [
        "bedrock:ListFoundationModels",
        "bedrock:GetFoundationModel",
        "bedrock:GetFoundationModelAvailability",
        "bedrock:ListInferenceProfiles"
      ],
      "Resource": "*"
    },
    {
      "Sid": "EcrRepository",
      "Effect": "Allow",
      "Action": "ecr:*",
      "Resource": "arn:aws:ecr:us-east-1:717279723515:repository/grounded-qa"
    },
    {
      "Sid": "EcrLogin",
      "Effect": "Allow",
      "Action": "ecr:GetAuthorizationToken",
      "Resource": "*"
    },
    {
      "Sid": "AppRunnerInThisAccount",
      "Effect": "Allow",
      "Action": "apprunner:*",
      "Resource": "arn:aws:apprunner:us-east-1:717279723515:*"
    },
    {
      "Sid": "AppRunnerListCalls",
      "Effect": "Allow",
      "Action": "apprunner:List*",
      "Resource": "*"
    },
    {
      "Sid": "CreateGroundedQaRolesWithBoundary",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole",
        "iam:PutRolePolicy",
        "iam:PutRolePermissionsBoundary"
      ],
      "Resource": "arn:aws:iam::717279723515:role/grounded-qa-*",
      "Condition": {
        "StringEquals": {
          "iam:PermissionsBoundary": "arn:aws:iam::717279723515:policy/grounded-qa-role-boundary"
        }
      }
    },
    {
      "Sid": "AttachAllowlistedPolicyToBoundedRoles",
      "Effect": "Allow",
      "Action": "iam:AttachRolePolicy",
      "Resource": "arn:aws:iam::717279723515:role/grounded-qa-*",
      "Condition": {
        "StringEquals": {
          "iam:PermissionsBoundary": "arn:aws:iam::717279723515:policy/grounded-qa-role-boundary"
        },
        "ArnEquals": {
          "iam:PolicyARN": [
            "arn:aws:iam::aws:policy/service-role/AWSAppRunnerServicePolicyForECRAccess",
            "arn:aws:iam::717279723515:policy/grounded-qa-bedrock-kill-switch"
          ]
        }
      }
    },
    {
      "Sid": "ReadDeleteTagGroundedQaRoles",
      "Effect": "Allow",
      "Action": [
        "iam:DeleteRole",
        "iam:GetRole",
        "iam:TagRole",
        "iam:UntagRole",
        "iam:GetRolePolicy",
        "iam:DeleteRolePolicy",
        "iam:ListRolePolicies",
        "iam:DetachRolePolicy",
        "iam:ListAttachedRolePolicies",
        "iam:ListInstanceProfilesForRole"
      ],
      "Resource": "arn:aws:iam::717279723515:role/grounded-qa-*"
    },
    {
      "Sid": "DenyRemovingRoleBoundary",
      "Effect": "Deny",
      "Action": "iam:DeleteRolePermissionsBoundary",
      "Resource": "arn:aws:iam::717279723515:role/grounded-qa-*"
    },
    {
      "Sid": "DenyEditingBoundaryOrOwnPolicy",
      "Effect": "Deny",
      "Action": [
        "iam:CreatePolicyVersion",
        "iam:SetDefaultPolicyVersion",
        "iam:DeletePolicy",
        "iam:DeletePolicyVersion"
      ],
      "Resource": [
        "arn:aws:iam::717279723515:policy/grounded-qa-role-boundary",
        "arn:aws:iam::717279723515:policy/grounded-qa-deploy"
      ]
    },
    {
      "Sid": "ManageOnlyKillSwitchPolicy",
      "Effect": "Allow",
      "Action": [
        "iam:CreatePolicy",
        "iam:GetPolicy",
        "iam:GetPolicyVersion",
        "iam:ListPolicyVersions",
        "iam:CreatePolicyVersion",
        "iam:DeletePolicyVersion",
        "iam:DeletePolicy",
        "iam:TagPolicy"
      ],
      "Resource": "arn:aws:iam::717279723515:policy/grounded-qa-bedrock-kill-switch"
    },
    {
      "Sid": "PassGroundedQaRoles",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::717279723515:role/grounded-qa-*"
    },
    {
      "Sid": "AppRunnerServiceLinkedRole",
      "Effect": "Allow",
      "Action": "iam:CreateServiceLinkedRole",
      "Resource": "arn:aws:iam::717279723515:role/aws-service-role/apprunner.amazonaws.com/AWSServiceRoleForAppRunner",
      "Condition": {
        "StringLike": {
          "iam:AWSServiceName": "apprunner.amazonaws.com"
        }
      }
    },
    {
      "Sid": "ReadAppRunnerLogs",
      "Effect": "Allow",
      "Action": [
        "logs:DescribeLogGroups",
        "logs:DescribeLogStreams",
        "logs:GetLogEvents",
        "logs:FilterLogEvents"
      ],
      "Resource": "arn:aws:logs:us-east-1:717279723515:log-group:/aws/apprunner/grounded-qa/*"
    },
    {
      "Sid": "MonthlyBudgetAndKillSwitchAction",
      "Effect": "Allow",
      "Action": [
        "budgets:ViewBudget",
        "budgets:ModifyBudget",
        "budgets:CreateBudgetAction",
        "budgets:DescribeBudgetAction",
        "budgets:DescribeBudgetActionsForBudget",
        "budgets:UpdateBudgetAction",
        "budgets:DeleteBudgetAction"
      ],
      "Resource": "arn:aws:budgets::717279723515:budget/grounded-qa-monthly"
    },
    {
      "Sid": "ManageGroundedQaCognito",
      "Effect": "Allow",
      "Action": "cognito-idp:*",
      "Resource": "arn:aws:cognito-idp:us-east-1:717279723515:userpool/*"
    },
    {
      "Sid": "ManageGroundedQaSsmParameters",
      "Effect": "Allow",
      "Action": [
        "ssm:PutParameter",
        "ssm:GetParameter",
        "ssm:GetParameters",
        "ssm:DeleteParameter",
        "ssm:AddTagsToResource",
        "ssm:RemoveTagsFromResource",
        "ssm:ListTagsForResource"
      ],
      "Resource": "arn:aws:ssm:us-east-1:717279723515:parameter/grounded-qa/*"
    }
  ]
}
