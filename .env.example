# grounded-qa environment configuration
#
# PROVIDER selects the LLM/embedding implementation. Exactly one provider
# block below should be active; the other is commented out as a reference.
# Copy this file to .env and fill in the active block for your setup.

# --- Active provider: openai-compatible (local LM Studio, the free default) ---
PROVIDER=openai-compatible
LLM_BASE_URL=http://localhost:1234/v1
LLM_API_KEY=lm-studio
LLM_MODEL=google/gemma-4-e4b
EMBEDDING_BASE_URL=http://localhost:1234/v1
EMBEDDING_API_KEY=lm-studio
EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5

# --- Alternative provider: bedrock (uncomment to use AWS Bedrock instead) ---
# PROVIDER=bedrock
# AWS_REGION=us-east-1
# BEDROCK_CHAT_MODEL_ID=deepseek.v3.2
# # fallback: amazon.nova-lite-v1:0
# BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
#
# Credentials are never set here: they come from the AWS SDK default
# credential chain. Locally that is usually a named profile, selected with
# AWS_PROFILE=<profile-name>; in AWS it is the IAM role attached to the
# running service.

# Optional
# PORT=3000
