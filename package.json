{
  "name": "grounded-qa",
  "version": "1.0.0",
  "private": true,
  "description": "Answers questions only from a built-in FAQ and uploaded PDFs, with verified verbatim citations.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "test": "tsx --test test/*.test.ts",
    "test:ui": "tsx --test test/ui/*.test.ts",
    "typecheck": "tsc --noEmit",
    "eval": "tsx scripts/eval.ts",
    "dev:bedrock": "PROVIDER=bedrock AWS_PROFILE=${AWS_PROFILE:-grounded-qa} AWS_REGION=${AWS_REGION:-us-east-1} BEDROCK_CHAT_MODEL_ID=${BEDROCK_CHAT_MODEL_ID:-deepseek.v3.2} BEDROCK_EMBEDDING_MODEL_ID=${BEDROCK_EMBEDDING_MODEL_ID:-amazon.titan-embed-text-v2:0} tsx watch src/server.ts",
    "eval:bedrock": "PROVIDER=bedrock AWS_PROFILE=${AWS_PROFILE:-grounded-qa} AWS_REGION=${AWS_REGION:-us-east-1} BEDROCK_CHAT_MODEL_ID=${BEDROCK_CHAT_MODEL_ID:-deepseek.v3.2} BEDROCK_EMBEDDING_MODEL_ID=${BEDROCK_EMBEDDING_MODEL_ID:-amazon.titan-embed-text-v2:0} tsx scripts/eval.ts"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1145.0",
    "express": "^5.2.1",
    "multer": "^2.4.0",
    "openai": "^7.26.0",
    "unpdf": "^1.8.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.4",
    "pdf-lib": "^1.17.1",
    "playwright-core": "^1.63.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
